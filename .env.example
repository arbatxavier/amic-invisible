# ===== App =====
# Ruta del archivo SQLite (mejor-sqlite3). En Docker: /app/data/amic.db
DATABASE_URL=./data/amic.db

# Contraseña del panel /admin
ADMIN_PASSWORD=cambia-esta-contrasena

# URL pública de la app (para enlaces privados en WhatsApp/ICS). Sin barra final.
APP_URL=https://amic.xavierarbat.com

# ===== WAHA (WhatsApp HTTP API) =====
# URL interna de WAHA (dentro de la red Docker): http://waha:3000
WAHA_URL=http://waha:3000
# Misma API key que configures en el contenedor WAHA (env WAHA_API_KEY)
WAHA_API_KEY=cambia-esta-api-key
