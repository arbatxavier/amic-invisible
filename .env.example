# ===== App =====
# SQLite file path (better-sqlite3). In Docker: /app/data/amic.db
DATABASE_URL=./data/amic.db

# Admin panel password
ADMIN_PASSWORD=change-this-password

# Public URL of the app (used for private links in WhatsApp/ICS). No trailing slash.
APP_URL=https://amic.xavierarbat.com

# ===== WAHA (WhatsApp HTTP API) =====
# Internal WAHA URL (inside the Docker network): http://waha:3000
WAHA_URL=http://waha:3000
# Same API key you set on the WAHA container (env WAHA_API_KEY)
WAHA_API_KEY=change-this-api-key
